// ============================================================
// .vscode/extensions.json (ALL-PY-REPOS)
// ============================================================
// Updated: 2026-10-11
//
// WHAT: A configuration file recommending Visual Studio Code extensions.
//       VS Code extensions add capabilities such as formatting, debugging,
//       documentation previews, syntax highlighting, and code assistance.
//       JSONC is JSON with comments, supported by VS Code configuration files.
//
// WHEN: Use in professional projects to recommend a consistent set of
//       development tools for everyone working on the project.
//
// WHY: Professional teams often establish recommended development tools.
//      Shared recommendations make project setup easier, help contributors
//      work consistently, and reduce configuration problems.
//      Other extensions may be used according to individual preferences.
//
// HOW: VS Code reads this file when the project folder is opened.
//      It may prompt users to install the recommended extensions.
//      Recommendations are optional and do not install extensions automatically.
//      Optional unwanted recommendations are extensions the project discourages;
//      they do not prevent users from installing them.
//
// SKILLS: VS Code, editor extensions, development environments,
//         project configuration, and team collaboration.
//
// REQ: Recommended extensions SHOULD support Windows, macOS, and Linux.
// REQ: Extensions required by settings.json SHOULD be recommended here.
// OBS: This is the shared baseline for all repositories.
//      Language-specific extensions may be added for particular project types.
// ============================================================
{
  "recommendations": [
    // ============================================================
    // === MARKDOWN AND DOCUMENTATION ===
    // ============================================================
    "DavidAnson.vscode-markdownlint", // Check Markdown using .markdownlint.jsonc rules
    "bierner.markdown-mermaid", // Diagram rendering in markdown (flowcharts, etc.)
    "bierner.markdown-preview-github-styles", // GitHub-style markdown preview
    "denisecase.comment-section-outline", // Show "# === Section ===" banners in the Outline view
    "esbenp.prettier-vscode", // Markdown formatting (see [markdown] in settings.json)
    "yzhang.markdown-all-in-one", // Shortcuts, TOC, formatting for .md files
    // ============================================================
    // === DATA FILES AND CONFIGURATION ===
    // ============================================================
    "redhat.vscode-yaml", // YAML syntax, validation, formatting
    "tamasfe.even-better-toml", // TOML syntax, validation
    "mechatroner.rainbow-csv", // Color-code CSV columns for readability
    // ============================================================
    // === PROJECT INFRASTRUCTURE ===
    // ============================================================
    "editorconfig.editorconfig", // Respects .editorconfig settings (indentation, line endings)
    "github.vscode-github-actions", // Syntax highlighting for .github/workflows/*.yml
    // ============================================================
    // === PYTHON DEVELOPMENT ===
    // ============================================================
    "astral-sh.ty", // Python type checking and language support
    "charliermarsh.ruff", // Python linting and formatting
    "ms-python.python", // Core Python development support
    // ============================================================
    // === PYTHON FILE PATH ASSISTANCE ===
    // ============================================================
    "christian-kohler.path-intellisense", // Autocomplete for file paths in Python strings (e.g., "data/file.csv")
    // NOTE: Terminal autocomplete (tab/right-arrow) is built into the shell (bash/zsh/PowerShell), not VS Code
    // ============================================================
    // === OPTIONAL (try if you want) ===
    // ============================================================
    // "fill-labs.dependi", // depdency update notifications in VS Code
    // "usernamehw.errorlens", // Inline error messages - helpful but can be noisy
    // "eamodio.gitlens", // Git history visualization - powerful but can be noisy
  ],
  "unwantedRecommendations": [
    // ============================================================
    // === ALTERNATIVES TO STANDARD PYTHON TOOLING ===
    // ============================================================
    "ms-python.black-formatter", // Ruff handles formatting
    "ms-python.isort", // Ruff handles import sorting
    "ms-pyright.pyright", // ty provides type checking
    "ms-python.vscode-pylance" // ty provides Python language support
  ]
}
